{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_type",
    "scope",
    "reasoning_complexity",
    "agentic_complexity",
    "ambiguity",
    "risk",
    "verification_difficulty",
    "context_requirement",
    "expected_task_length",
    "confidence",
    "number_of_expected_steps",
    "cross_module_dependency",
    "relevant_files",
    "implementation_plan",
    "verification_steps",
    "risks",
    "suggested_execution_tier"
  ],
  "properties": {
    "task_type": {"enum": ["simple_edit", "documentation", "test_generation", "implementation", "refactor", "debugging", "architecture", "repository_analysis", "migration", "performance", "security", "unknown"]},
    "scope": {"enum": ["single_line", "single_file", "multi_file", "repository", "multi_repository", "unknown"]},
    "reasoning_complexity": {"enum": ["low", "medium", "high", "very_high"]},
    "agentic_complexity": {"enum": ["low", "medium", "high", "very_high"]},
    "ambiguity": {"enum": ["low", "medium", "high", "very_high"]},
    "risk": {"enum": ["low", "medium", "high", "very_high"]},
    "verification_difficulty": {"enum": ["low", "medium", "high", "very_high"]},
    "context_requirement": {"enum": ["small", "medium", "large", "very_large"]},
    "expected_task_length": {"enum": ["short", "medium", "long", "very_long"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "number_of_expected_steps": {"type": "integer", "minimum": 1, "maximum": 50},
    "cross_module_dependency": {"type": "boolean"},
    "relevant_files": {"type": "array", "items": {"type": "string"}, "maxItems": 50},
    "implementation_plan": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 30},
    "verification_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 20},
    "risks": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "suggested_execution_tier": {"type": ["string", "null"], "enum": ["luna", "terra", "sol", "astra", null]}
  }
}
